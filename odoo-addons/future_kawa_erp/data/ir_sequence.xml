<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ============================================================ -->
        <!-- Sequence for automatic coffee batch reference generation     -->
        <!-- noupdate="1" prevents the sequence from being reset on every -->
        <!-- module update, which would recreate existing batch refs.     -->
        <!-- ============================================================ -->
        <record id="seq_batch_reference" model="ir.sequence">
            <field name="name">FutureKawa Batch Reference</field>
            <field name="code">future_kawa.batch.reference</field>
            <field name="prefix">LOT-</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
