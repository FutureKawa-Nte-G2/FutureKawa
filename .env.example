# Copier en .env (`make env`). .env est gitignoré.

# Odoo
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
ODOO_PORT=8069
ODOO_DB_NAME=futurekawa
ODOO_ADMIN_LOGIN=admin@admin.com
ODOO_ADMIN_PASSWORD=Not24get
ODOO_WEBHOOK_TOKEN=futurekawa-webhook-shared-token

# Base du backend siège
SIEGE_DB_NAME=FutureKawaSiege
SIEGE_DB_USER=postgres
SIEGE_DB_PASSWORD=Not24get
# 5432 = PostgreSQL local, 5433 = odoo-db. Mettre 5432 ici si aucun PostgreSQL
# n'est installé sur la machine : appsettings.Development.json marche alors tel quel.
SIEGE_DB_PORT=5435

# API du siège
SIEGE_API_PORT=55648
# 32 caractères minimum : plus court, le conteneur démarre quand même et le
# premier login renvoie 500.
JWT_SECRET=dev-secret-change-in-production-min-32-chars!!
# Origine exacte vue par le navigateur, autorisée en CORS. Toujours localhost,
# jamais 127.0.0.1 : ce sont deux sites différents et le cookie de refresh
# (SameSite=Strict) ne serait plus envoyé.
FRONTEND_ORIGIN=http://localhost:3000
