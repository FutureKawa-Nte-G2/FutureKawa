# Country database. One instance of this API serves one country.
DATABASE_URL=postgresql+asyncpg://futurekawa:futurekawa@localhost:5434/futurekawa_br

# Shared secret head office sends in X-API-Key on the routes it pulls.
LOCAL_API_KEY=change-me

# Broker MQTT auquel les consumers s'abonnent. Le broker lui-même est
# configuré par l'US #31 ; ces valeurs sont celles d'un Mosquitto local.
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
