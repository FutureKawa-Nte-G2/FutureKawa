{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=FutureKawaSiege;Username=postgres;Password=Not24get"
  },
  "Jwt": {
    "Secret": "dev-secret-change-in-production-min-32-chars!!",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7,
    "Issuer": "FutureKawaSiege",
    "Audience": "FutureKawaSiege"
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "Refresh": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "OdooWebhook": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "Odoo": {
    "Url": "http://localhost:8069",
    "Db": "futurekawa",
    "Username": "admin@admin.com",
    "Password": "Not24get",
    "WebhookToken": "futurekawa-webhook-shared-token"
  },
  "MeasurementSync": {
    "LocalApiUrl": "http://127.0.0.1:8000/api/measurements",
    "IntervalMinutes": 1440,
    "UseMockData": false
  },
  "LocalApi": {
    "ApiKey": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  }
}
