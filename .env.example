# Copier en .env (`make env`). .env est gitignoré.

# Odoo
POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo
ODOO_PORT=8069
ODOO_DB_NAME=futurekawa
ODOO_ADMIN_LOGIN=admin@admin.com
ODOO_ADMIN_PASSWORD=Not24get
ODOO_WEBHOOK_TOKEN=futurekawa-webhook-shared-token

# Base du backend siège
SIEGE_DB_NAME=FutureKawaSiege
SIEGE_DB_USER=postgres
SIEGE_DB_PASSWORD=Not24get
# 5432 = PostgreSQL local, 5433 = odoo-db. Mettre 5432 ici si aucun PostgreSQL
# n'est installé sur la machine : appsettings.Development.json marche alors tel quel.
SIEGE_DB_PORT=5435

# Base d'un pays, lue par l'API locale (Api/). Ces valeurs doivent rester
# alignées sur le DATABASE_URL de Api/.env.
WAREHOUSE_DB_NAME=futurekawa_br
WAREHOUSE_DB_USER=futurekawa
WAREHOUSE_DB_PASSWORD=futurekawa
WAREHOUSE_DB_PORT=5434
# API du siège
SIEGE_API_PORT=55648
# 32 caractères minimum : plus court, le conteneur démarre quand même et le
# premier login renvoie 500.
JWT_SECRET=dev-secret-change-in-production-min-32-chars!!
# Origine exacte vue par le navigateur, autorisée en CORS. Toujours localhost,
# jamais 127.0.0.1 : ce sont deux sites différents et le cookie de refresh
# (SameSite=Strict) ne serait plus envoyé.
FRONTEND_ORIGIN=http://localhost:3000

# URL de l'API pays, telle que le conteneur du siège doit la joindre. Nom du
# service compose et non host.docker.internal : l'API pays étant conteneurisée,
# le trafic reste sur le réseau Docker.
WAREHOUSE_API_URL=http://country-api:8000/api/measurements

# API pays
COUNTRY_API_PORT=8000
# Secret partagé que le siège envoie en X-API-Key sur les routes qu'il tire.
LOCAL_API_KEY=change-me

# Frontend. Doit rester cohérent avec FRONTEND_ORIGIN ci-dessus : c'est la même
# origine, vue une fois côté port publié et une fois côté CORS du backend.
FRONTEND_PORT=3000

# Broker MQTT. Publié sur l'hôte pour pouvoir injecter un relevé de test
# (mosquitto_pub) sans entrer dans un conteneur.
MQTT_PORT=1883
