# Country database. One instance of this API serves one country.
DATABASE_URL=postgresql+asyncpg://futurekawa:futurekawa@localhost:5434/futurekawa_br

# Country key, used both ways: must match LocalApi:Countries:BR:ApiKey on head office.
LOCAL_API_KEY=change-me

HEAD_OFFICE_ALERTS_URL=http://localhost:55648/api/alerts

# MQTT broker the consumers subscribe to (a local Mosquitto).
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
